####### Posibilidad de anisotropía.
#El ángulo de orientación es de aproximadamente 335 grados o 0.9305556*pi

# variog4 pide 4 angulos en unidades de pi.  En nuestro caso serían (65/360)*pi; 
# (155/360)*pi: (245/360)*pi y (335/360)*pi

CO.4<-variog4(CO.geo,trend="2nd",maxdist=10,direction=c((65/360)*pi,(155/360)*pi,
                                                        (245/360)*pi,(335/360)*pi),tolerance=pi/8,unit.angle="radians")

plot(CO.4)

