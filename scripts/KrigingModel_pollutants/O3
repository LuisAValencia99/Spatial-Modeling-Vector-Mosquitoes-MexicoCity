#####Promedios totales

OverallStats <- function(data, date_column = "FECHA", hour_column = "HORA") {
  # Eliminar las columnas de fecha y hora del dataframe
  data <- data %>%
    select(-all_of(c(date_column, hour_column)))
  
  # Reemplazar valores -99 por NA en columnas numéricas
  data <- data %>%
    mutate(across(where(is.numeric), ~ replace(., . == -99, NA)))
  
  # Calcular el promedio y desviación estándar para cada columna numérica
  stats <- data %>%
    summarise(across(where(is.numeric), 
                     list(mean = ~ mean(., na.rm = TRUE), 
                          sd = ~ sd(., na.rm = TRUE)), 
                     .names = "{.col}_{.fn}"))
  
  # Transponer a un formato más legible (opcional)
  stats <- pivot_longer(stats, everything(), 
                        names_to = c("Variable", ".value"), 
                        names_sep = "_")
  
  return(stats)
}

